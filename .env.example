# HotelPro Platform Environment Variables

# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (MongoDB connection string, or leave blank to auto-use embedded MongoDB for testing)
MONGODB_URI=mongodb://localhost:27017/hotelpro

# JWT & Authentication Secrets
JWT_SECRET=hotelpro_super_secret_jwt_key_development_32chars_min
JWT_EXPIRE=7d
COOKIE_EXPIRE_DAYS=7

# Email / SMTP Configuration (Nodemailer)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=test_smtp_user
SMTP_PASSWORD=test_smtp_password
EMAIL_FROM=HotelPro Reservations <no-reply@hotelpro.com>

# Payment Gateway Configuration (Test Mode)
# Razorpay (India & selected regions)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecret

# Stripe (International)
STRIPE_SECRET_KEY=sk_test_YourStripeSecretKeyHere
STRIPE_WEBHOOK_SECRET=whsec_YourStripeWebhookSecret

# Payment Gateway Selection: "mock" | "stripe" | "razorpay"
PAYMENT_GATEWAY_PROVIDER=mock

# Cloudinary / Image Storage (Optional in dev; falls back to local upload storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

